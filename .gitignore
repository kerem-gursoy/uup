# Dependencies
node_modules/
.pnp
.pnp.js

# Database files
*.db
*.db-journal
*.sqlite
*.sqlite3

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Wrangler's local secrets file. The .env patterns above do NOT match it, and it
# holds the real Gemini and JWT values for `wrangler dev`.
.dev.vars
.dev.vars.*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build outputs
dist
dist-ssr
build
*.local

# Testing
coverage
.nyc_output

# Wrangler local state: the simulated D1 database and R2 bucket used by
# `wrangler dev`, plus its build cache. Local scratch, never committed.
.wrangler/
# worker-configuration.d.ts is deliberately NOT ignored: tsconfig includes it,
# so `npm run typecheck` would fail on a fresh clone without it. Regenerate with
# `npm run types` after changing bindings in wrangler.jsonc.

# Misc
.cache
.temp
.tmp

# Local review artifacts (generated HTML + screenshots, not project files)
.lavish/

# Exported Claude Code transcripts, kept as a human-readable record of why the
# bigger changes were made - the reasoning behind a commit rather than the
# commit itself. Local notes, not project files: they are raw terminal dumps,
# they date quickly, and nothing in the build reads them.
session-logs/
