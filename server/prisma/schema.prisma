generator client {
  provider        = "prisma-client-js"
  // Required to talk to D1 through @prisma/adapter-d1. D1 is SQLite, so the
  // datasource provider and every model below stay exactly as they are.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  /// `name` with case, spacing, accents and punctuation folded away - see
  /// services/textKeys.ts. Deliberately NOT unique: two products may honestly
  /// share it ("Su 5L" from two suppliers), so this warns rather than forbids.
  /// It is also what product search matches on, which is what makes searching
  /// "ISIK" find "Işık".
  nameFingerprint String?
  barcode        String?         @unique
  brand          String?
  supplierId     Int?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  priceHistory   PriceHistory[]
  stockMovements StockMovement[]
  supplierItems  SupplierItem[]

  @@index([nameFingerprint])
}

model Supplier {
  id        Int       @id @default(autoincrement())
  /// As the user typed it, tidied of stray whitespace. This is what gets shown.
  name      String
  /// Case- and spacing-insensitive form of `name`. Unique, so the same supplier
  /// cannot be entered twice as "Acme", "ACME" and "acme".
  nameKey   String    @unique
  products  Product[]
  invoices  Invoice[]
  items     SupplierItem[]
}

/// What this supplier's own wording for a line turned out to mean, the last time
/// a human applied an invoice containing it.
///
/// This is the app's entire memory of invoice-to-product matching, and it is
/// built only from decisions a person actually made and applied - never from a
/// guess. That is what lets services/productMatching.ts reuse a row here as
/// certain evidence rather than as a suggestion.
///
/// `kind` says what sort of evidence the row holds:
///   CODE  - the supplier's stock code (Stok Kodu), folded by codeKey()
///   DESC  - the line description, folded by textFingerprint(), for the many
///           suppliers who print no code at all
model SupplierItem {
  id           Int      @id @default(autoincrement())
  supplierId   Int
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  kind         String
  /// The folded code or description. Unique per supplier and kind, so the most
  /// recent human decision replaces the previous one rather than competing.
  value        String
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])
  /// The text as it was printed, kept so the review screen can say *why* a line
  /// matched without having to un-fold `value`.
  lastSeenText String?
  /// How many applied invoices have confirmed this mapping. Not used to decide a
  /// match - one human confirmation is already enough - but it is the number
  /// worth looking at when a mapping turns out to be wrong.
  timesSeen    Int      @default(1)
  updatedAt    DateTime @default(now())

  @@unique([supplierId, kind, value])
  @@index([productId])
}

model Invoice {
  id           Int       @id @default(autoincrement())
  supplierId   Int
  supplier     Supplier  @relation(fields: [supplierId], references: [id])

  originalName String
  storedPath   String
  mimeType     String
  status       String    @default("UPLOADED")
  createdAt    DateTime  @default(now())

  /// What the model read off the document, as JSON - see services/invoiceReview.ts
  /// for the shape. Kept because the document is immutable and the reading is
  /// slow and paid for: re-deriving it every time the review screen opens is a
  /// second Gemini call for an answer we already have.
  parsedJson     String?
  parsedAt       DateTime?

  /// The reviewer's unfinished work on the review screen, so closing the app
  /// mid-invoice is not the same as throwing the work away. Opaque JSON on
  /// purpose - it is that screen's own state, and the server has no business
  /// having an opinion about it beyond the guards in services/invoiceReview.ts.
  ///
  /// Always belongs to the reading in `parsedJson`: a re-read clears it, because
  /// its line positions would no longer refer to anything.
  draftJson      String?
  draftUpdatedAt DateTime?
}

/// One dated price entry for a product.
/// `kind` is "COST" (what we pay the supplier) or "SELL" (what we charge the
/// customer). Both are kept as history rather than a single current value, so
/// the business can always answer "what did this cost us back then?".
model PriceHistory {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      Product   @relation(fields: [productId], references: [id])
  kind         String
  priceCents   Int
  note         String?
  effectiveFrom DateTime @default(now())

  @@unique([productId, kind, effectiveFrom])
  @@index([productId, kind, effectiveFrom])
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product   @relation(fields: [productId], references: [id])
  quantity  Int
  reason    String
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}


model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}
