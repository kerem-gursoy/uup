{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    // Wrangler's esbuild bundles src/index.ts directly, so TypeScript never
    // emits: it is the typecheck gate only (`npm run typecheck`). Bundler
    // resolution is what lets the Workers-only `cloudflare:*` modules resolve.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,

    // Workers runtime globals come from worker-configuration.d.ts (generated by
    // `npx wrangler types`, included below). @cloudflare/workers-types is what
    // declares the `cloudflare:workers` module the D1 binding is read from, and
    // "node" covers the admin CLI script under scripts/, which runs on Node.
    "types": ["@cloudflare/workers-types", "node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "../worker-configuration.d.ts"]
}
