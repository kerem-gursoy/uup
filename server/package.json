{
  "type": "module",
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@prisma/adapter-d1": "6.19.0",
    "@prisma/client": "6.19.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2"
  },
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --config ../wrangler.jsonc --dry-run",
    "client:build": "npm --prefix ../client run build",
    "deploy": "npm run client:build && wrangler deploy --config ../wrangler.jsonc",
    "types": "wrangler types --config ../wrangler.jsonc --include-runtime=false",
    "db:migrate:local": "wrangler d1 migrations apply uup-db --local --config ../wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply uup-db --remote --config ../wrangler.jsonc",
    "user:admin": "tsx scripts/admin-user.ts",
    "db:backfill-fingerprints": "tsx scripts/backfill-fingerprints.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.116.0"
  }
}
